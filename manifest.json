{
  "manifest_version": 3,
  "name": "OmniSense",
  "version": "0.1.0",
  "description": "本地 AI 浏览器助手 — 所有处理在你的设备上完成",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "scripting",
    "activeTab",
    "contextMenus",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist-subset",
        "enabled": true,
        "path": "rules/easylist-subset.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/cosmetic-filter.js", "content/capsule-capture.js", "content/read-along.js", "content/pattern-radar.js", "content/zen-reader.js", "content/selection-pill.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*", "vendor/**/*", "rules/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
